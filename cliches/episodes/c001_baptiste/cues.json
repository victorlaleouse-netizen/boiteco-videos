[{"t0": 0.0, "t1": 1.28, "text": "VOICI BAPTISTE"}, {"t0": 1.28, "t1": 2.32, "text": "LE JEUNE ENTREPRENEUR"}, {"t0": 2.32, "t1": 3.2, "text": "LIBÉRAL"}, {"t0": 3.2, "t1": 4.32, "text": "BAPTISTE A VINGT-SIX"}, {"t0": 4.32, "t1": 4.68, "text": "ANS"}, {"t0": 4.68, "t1": 5.28, "text": "ET UNE DOUDOUNE"}, {"t0": 5.28, "t1": 5.96, "text": "SANS MANCHES QU'IL"}, {"t0": 5.96, "t1": 7.24, "text": "NE QUITTE JAMAIS"}, {"t0": 7.24, "t1": 8.0, "text": "CHAQUE MATIN"}, {"t0": 8.0, "t1": 8.48, "text": "IL SE LÈVE"}, {"t0": 8.48, "t1": 9.486, "text": "À CINQ HEURES"}, {"t0": 9.486, "t1": 10.28, "text": "POUR POSTER QU'IL"}, {"t0": 10.28, "t1": 10.68, "text": "SE LÈVE À"}, {"t0": 10.68, "t1": 11.52, "text": "CINQ HEURES"}, {"t0": 11.52, "t1": 12.08, "text": "SUR SON RÉSEAU"}, {"t0": 12.08, "t1": 12.64, "text": "PRO"}, {"t0": 12.64, "t1": 13.88, "text": "IL EST CEO"}, {"t0": 13.88, "t1": 14.52, "text": "DE SA PROPRE"}, {"t0": 14.52, "t1": 15.067, "text": "BOÎTE"}, {"t0": 15.067, "t1": 15.44, "text": "OÙ IL EST"}, {"t0": 15.44, "t1": 16.64, "text": "LE SEUL SALARIÉ"}, {"t0": 16.64, "t1": 17.547, "text": "SA START-UP"}, {"t0": 17.547, "t1": 18.16, "text": "UNE APPLI QUI"}, {"t0": 18.16, "t1": 19.32, "text": "LIVRE DES CROISSANTS…"}, {"t0": 19.32, "t1": 20.12, "text": "PAR ABONNEMENT"}, {"t0": 20.12, "t1": 21.12, "text": "IL APPELLE ÇA"}, {"t0": 21.12, "t1": 22.52, "text": "DISRUPTER LA BOULANGERIE"}, {"t0": 22.52, "t1": 22.92, "text": "AU REPAS DE"}, {"t0": 22.92, "t1": 23.48, "text": "FAMILLE"}, {"t0": 23.48, "t1": 24.16, "text": "IL EXPLIQUE QUE"}, {"t0": 24.16, "t1": 24.747, "text": "L'ÉTAT"}, {"t0": 24.747, "t1": 25.64, "text": "C'EST LE PROBLÈME"}, {"t0": 25.64, "t1": 26.0, "text": "ET QUE LES"}, {"t0": 26.0, "t1": 26.52, "text": "AIDES"}, {"t0": 26.52, "t1": 27.0, "text": "ÇA REND LES"}, {"t0": 27.0, "t1": 28.04, "text": "GENS ASSISTÉS"}, {"t0": 28.04, "t1": 28.8, "text": "LE LENDEMAIN"}, {"t0": 28.8, "t1": 29.4, "text": "IL REMPLIT SON"}, {"t0": 29.4, "t1": 30.4, "text": "DOSSIER DE SUBVENTION"}, {"t0": 30.4, "t1": 31.2, "text": "INNOVATION"}, {"t0": 31.2, "t1": 31.88, "text": "IL RÉPÈTE QU'IL"}, {"t0": 31.88, "t1": 32.52, "text": "NE DOIT RIEN"}, {"t0": 32.52, "t1": 33.26, "text": "À PERSONNE"}, {"t0": 33.26, "t1": 33.72, "text": "JE ME SUIS"}, {"t0": 33.72, "t1": 34.784, "text": "FAIT TOUT SEUL"}, {"t0": 34.784, "t1": 35.48, "text": "PENDANT CE TEMPS"}, {"t0": 35.48, "t1": 36.24, "text": "PAPA SIGNE LE"}, {"t0": 36.24, "t1": 36.84, "text": "CHÈQUE"}, {"t0": 36.84, "t1": 37.88, "text": "QUATRE-VINGT MILLE EUROS"}, {"t0": 37.88, "t1": 38.36, "text": "POUR LANCER LA"}, {"t0": 38.36, "t1": 39.12, "text": "BOÎTE"}, {"t0": 39.12, "t1": 39.627, "text": "SIX MOIS PLUS"}, {"t0": 39.627, "t1": 40.12, "text": "TARD"}, {"t0": 40.12, "t1": 42.224, "text": "LA START-UP FERME"}, {"t0": 42.224, "t1": 43.4, "text": "BAPTISTE PUBLIE UN"}, {"t0": 43.4, "t1": 44.224, "text": "LONG POST"}, {"t0": 44.224, "t1": 44.64, "text": "CE QUE MON"}, {"t0": 44.64, "t1": 45.6, "text": "ÉCHEC M'A APPRIS"}, {"t0": 45.6, "t1": 46.72, "text": "SUR LE LEADERSHIP"}, {"t0": 46.72, "t1": 48.56, "text": "TROIS MILLE LIKES"}, {"t0": 48.56, "t1": 49.16, "text": "IL LANCE SON"}, {"t0": 49.16, "t1": 49.84, "text": "PODCAST"}, {"t0": 49.84, "t1": 50.72, "text": "ABONNE-TOI"}, {"t0": 50.72, "t1": 51.2, "text": "DEMAIN"}, {"t0": 51.2, "t1": 51.64, "text": "C'EST LE TOUR"}, {"t0": 51.64, "t1": 53.52, "text": "D'UN AUTRE CLICHÉ"}]