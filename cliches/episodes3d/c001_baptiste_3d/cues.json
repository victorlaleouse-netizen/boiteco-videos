[{"t0": 0.0, "t1": 1.28, "text": "VOICI BAPTISTE"}, {"t0": 1.28, "t1": 2.32, "text": "LE JEUNE ENTREPRENEUR"}, {"t0": 2.32, "t1": 3.2, "text": "LIBÉRAL"}, {"t0": 3.2, "t1": 4.32, "text": "BAPTISTE A VINGT-SIX"}, {"t0": 4.32, "t1": 4.68, "text": "ANS"}, {"t0": 4.68, "t1": 5.28, "text": "ET UNE DOUDOUNE"}, {"t0": 5.28, "t1": 5.96, "text": "SANS MANCHES QU'IL"}, {"t0": 5.96, "t1": 7.24, "text": "NE QUITTE JAMAIS"}, {"t0": 7.24, "t1": 8.0, "text": "CHAQUE MATIN"}, {"t0": 8.0, "t1": 8.48, "text": "IL SE LÈVE"}, {"t0": 8.48, "t1": 9.486, "text": "À CINQ HEURES"}, {"t0": 9.486, "t1": 10.28, "text": "POUR POSTER QU'IL"}, {"t0": 10.28, "t1": 10.68, "text": "SE LÈVE À"}, {"t0": 10.68, "t1": 11.52, "text": "CINQ HEURES"}, {"t0": 11.52, "t1": 12.08, "text": "SUR SON RÉSEAU"}, {"t0": 12.08, "t1": 12.64, "text": "PRO"}, {"t0": 12.64, "t1": 13.88, "text": "IL EST CEO"}, {"t0": 13.88, "t1": 14.52, "text": "DE SA PROPRE"}, {"t0": 14.52, "t1": 15.067, "text": "BOÎTE"}, {"t0": 15.067, "t1": 15.44, "text": "OÙ IL EST"}, {"t0": 15.44, "t1": 17.46, "text": "LE SEUL SALARIÉ"}, {"t0": 17.84, "t1": 18.747, "text": "SA START-UP"}, {"t0": 18.747, "t1": 19.36, "text": "UNE APPLI QUI"}, {"t0": 19.36, "t1": 20.52, "text": "LIVRE DES CROISSANTS…"}, {"t0": 20.52, "t1": 21.32, "text": "PAR ABONNEMENT"}, {"t0": 21.32, "t1": 22.32, "text": "IL APPELLE ÇA"}, {"t0": 22.32, "t1": 24.18, "text": "DISRUPTER LA BOULANGERIE"}, {"t0": 25.02, "t1": 25.42, "text": "AU REPAS DE"}, {"t0": 25.42, "t1": 25.98, "text": "FAMILLE"}, {"t0": 25.98, "t1": 26.66, "text": "IL EXPLIQUE QUE"}, {"t0": 26.66, "t1": 27.247, "text": "L'ÉTAT"}, {"t0": 27.247, "t1": 28.14, "text": "C'EST LE PROBLÈME"}, {"t0": 28.14, "t1": 28.5, "text": "ET QUE LES"}, {"t0": 28.5, "t1": 29.02, "text": "AIDES"}, {"t0": 29.02, "t1": 29.5, "text": "ÇA REND LES"}, {"t0": 29.5, "t1": 30.54, "text": "GENS ASSISTÉS"}, {"t0": 30.54, "t1": 32.5, "text": "LE LENDEMAIN"}, {"t0": 32.5, "t1": 33.1, "text": "IL REMPLIT SON"}, {"t0": 33.1, "t1": 34.1, "text": "DOSSIER DE SUBVENTION"}, {"t0": 34.1, "t1": 35.72, "text": "INNOVATION"}, {"t0": 36.2, "t1": 36.88, "text": "IL RÉPÈTE QU'IL"}, {"t0": 36.88, "t1": 37.52, "text": "NE DOIT RIEN"}, {"t0": 37.52, "t1": 38.26, "text": "À PERSONNE"}, {"t0": 38.26, "t1": 38.72, "text": "JE ME SUIS"}, {"t0": 38.72, "t1": 40.54, "text": "FAIT TOUT SEUL"}, {"t0": 40.784, "t1": 41.48, "text": "PENDANT CE TEMPS"}, {"t0": 41.48, "t1": 42.24, "text": "PAPA SIGNE LE"}, {"t0": 42.24, "t1": 42.84, "text": "CHÈQUE"}, {"t0": 42.84, "t1": 43.88, "text": "QUATRE-VINGT MILLE EUROS"}, {"t0": 43.88, "t1": 44.36, "text": "POUR LANCER LA"}, {"t0": 44.36, "t1": 45.12, "text": "BOÎTE"}, {"t0": 45.12, "t1": 45.627, "text": "SIX MOIS PLUS"}, {"t0": 45.627, "t1": 46.12, "text": "TARD"}, {"t0": 46.12, "t1": 48.5, "text": "LA START-UP FERME"}, {"t0": 49.824, "t1": 51.0, "text": "BAPTISTE PUBLIE UN"}, {"t0": 51.0, "t1": 51.824, "text": "LONG POST"}, {"t0": 51.824, "t1": 52.24, "text": "CE QUE MON"}, {"t0": 52.24, "t1": 53.2, "text": "ÉCHEC M'A APPRIS"}, {"t0": 53.2, "t1": 54.32, "text": "SUR LE LEADERSHIP"}, {"t0": 54.32, "t1": 56.16, "text": "TROIS MILLE LIKES"}, {"t0": 56.16, "t1": 56.76, "text": "IL LANCE SON"}, {"t0": 56.76, "t1": 58.22, "text": "PODCAST"}, {"t0": 58.64, "t1": 59.52, "text": "ABONNE-TOI"}, {"t0": 59.52, "t1": 60.0, "text": "DEMAIN"}, {"t0": 60.0, "t1": 60.44, "text": "C'EST LE TOUR"}, {"t0": 60.44, "t1": 62.32, "text": "D'UN AUTRE CLICHÉ"}]